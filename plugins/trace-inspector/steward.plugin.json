{
  "protocol": "steward-rsi-plugins/0.1",
  "plugin_id": "steward.trace-inspector",
  "version": "1.1.0",
  "feature_ids": [
    "F-031",
    "F-034",
    "F-035",
    "F-036"
  ],
  "runtime": {
    "entry": "plugin",
    "timeout_ms": 30000
  },
  "files": [],
  "provides": [
    {
      "contract": "steward.trace-layout/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "input_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "parent_outside": {
                  "type": "boolean"
                },
                "has_children": {
                  "type": "boolean"
                },
                "guides": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "boolean"
                  }
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 990
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "primary": {
                  "type": "boolean"
                },
                "primary_has_children": {
                  "type": "boolean"
                },
                "running": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "depth",
                "parent_outside",
                "has_children",
                "guides",
                "x",
                "width"
              ],
              "additionalProperties": false
            }
          },
          "ttft_ms": {
            "type": "integer",
            "minimum": 0
          },
          "tabs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "overview",
                "context",
                "wire",
                "diff"
              ]
            }
          },
          "timeline": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "first_output_at": {
            "type": "integer",
            "minimum": 1
          },
          "output_rate": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "nodes",
          "tabs",
          "timeline"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.trace-diff/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "input_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "added",
                    "removed",
                    "changed",
                    "moved"
                  ]
                },
                "before": {
                  "type": "integer",
                  "minimum": 0
                },
                "after": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "maxLength": 8192
                }
              },
              "required": [
                "kind",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "next": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.trace-tool-preview/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "input_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "texts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "artifacts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "images": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "texts",
              "artifacts",
              "images"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "contract": "steward.trace-workbench/1",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "program": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "enum": [
                  "trace-workbench-program"
                ]
              },
              "digest": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            },
            "required": [
              "resource",
              "digest",
              "source"
            ],
            "additionalProperties": false
          },
          "stylesheet": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "enum": [
                  "trace-activity-styles"
                ]
              },
              "digest": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            },
            "required": [
              "resource",
              "digest",
              "source"
            ],
            "additionalProperties": false
          },
          "template": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "enum": [
                  "trace-workbench-template"
                ]
              },
              "digest": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            },
            "required": [
              "resource",
              "digest",
              "source"
            ],
            "additionalProperties": false
          },
          "copy": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "enum": [
                  "trace-workbench-copy"
                ]
              },
              "digest": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            },
            "required": [
              "resource",
              "digest",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "program",
          "stylesheet",
          "template",
          "copy"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.trace-activity/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "input_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "present": {
            "type": "boolean"
          },
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          },
          "base": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          }
        },
        "required": [
          "present",
          "start",
          "end",
          "base",
          "step"
        ],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "state": {
    "version": 1,
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "initial": {}
  },
  "requests": [
    "input.read"
  ],
  "resources": [
    {
      "kind": "view",
      "name": "trace-workbench-program",
      "path": "views/trace-worker.js"
    },
    {
      "kind": "view",
      "name": "trace-activity-styles",
      "path": "views/trace-activity.css"
    },
    {
      "kind": "view",
      "name": "trace-workbench-template",
      "path": "views/trace.html"
    },
    {
      "kind": "view",
      "name": "trace-workbench-copy",
      "path": "views/copy.json"
    }
  ]
}
