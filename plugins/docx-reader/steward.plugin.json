              "RESOURCE_LIMIT"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "state": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false
