{
  "protocol": "steward-rsi-plugins/0.1",
  "plugin_id": "steward.experience-learning",
  "version": "1.0.2",
  "feature_ids": [
    "F-023"
  ],
  "runtime": {
    "entry": "plugin",
    "timeout_ms": 30000
  },
  "files": [],
  "provides": [
    {
      "contract": "steward.experience-policy/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "success",
              "correction",
              "recovered_failure"
            ]
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "required_runs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "introduction": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "required_runs",
          "introduction"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.browser-demonstration/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "activate",
                    "enter",
                    "select"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "action",
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 32,
            "minItems": 1
          },
          "sample": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                },
                "step": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "activate",
                        "enter",
                        "select"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "required": [
                    "action",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "to": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                }
              },
              "required": [
                "from",
                "step",
                "to"
              ],
              "additionalProperties": false
            },
            "maxItems": 64,
            "minItems": 0
          },
          "goal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        },
        "required": [
          "name",
          "steps",
          "sample",
          "goal"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 900
            },
            "maxItems": 32,
            "minItems": 1
          },
          "matched": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "steps",
          "matched",
          "verified"
        ],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "state": {
    "version": 1,
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "initial": {}
  },
  "requests": []
}
