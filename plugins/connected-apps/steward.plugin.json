{
  "protocol": "steward-rsi-plugins/0.1",
  "plugin_id": "steward.connected-apps",
  "version": "1.0.2",
  "feature_ids": [
    "F-071"
  ],
  "runtime": {
    "entry": "plugin",
    "timeout_ms": 10000
  },
  "files": [],
  "provides": [
    {
      "contract": "steward.apps-method/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "search",
              "execute"
            ]
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "inline",
              "artifact"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "mode",
          "name",
          "message"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.apps-guidance/1",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "maxLength": 4096
              },
              "after": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "search": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "maxLength": 4096
              },
              "after": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "execute": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "maxLength": 4096
              },
              "after": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "namespace",
          "search",
          "execute"
        ],
        "additionalProperties": false
      }
    },
    {
      "contract": "steward.apps-mail-review/1",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "toolkit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "from",
                    "to",
                    "cc",
                    "bcc",
                    "subject",
                    "attachments",
                    "body"
                  ]
                }
              },
              "required": [
                "key",
                "role"
              ]
            }
          }
        },
        "required": [
          "toolkit",
          "operation",
          "fields"
        ]
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "state": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false
