{
  "protocol": "steward-rsi-plugins/0.1",
  "plugin_id": "steward.web-extract",
  "version": "1.0.1",
  "feature_ids": [
    "F-069"
  ],
  "runtime": {
    "entry": "plugin",
    "timeout_ms": 30000
  },
  "files": [],
  "provides": [
    {
      "contract": "steward.web-extract/1",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "enum": [
              "document"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 4096
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/html",
              "application/pdf"
            ]
          }
        },
        "required": [
          "input_id",
          "url",
          "media_type"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "title_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "text_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "error_code": {
            "type": "string",
            "enum": [
              "",
              "WEB_EXTRACTION_FAILED",
              "WEB_EXTRACTOR_UNAVAILABLE"
            ]
          },
          "digest": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "title_bytes",
          "text_bytes",
          "error_code",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  ],
  "requests": [
    "input.read",
    "compute.web-extract"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "runtime_revision": {
        "type": "string",
        "maxLength": 128
      },
      "source_identity": {
        "type": "string",
        "maxLength": 128
      },
      "unavailable_error": {
        "type": "string",
        "enum": [
          "",
          "WEB_EXTRACTOR_UNAVAILABLE",
          "WEB_EXTRACTION_FAILED"
        ]
      }
    },
    "required": [
      "runtime_revision",
      "source_identity"
    ],
    "additionalProperties": false
  },
  "state": {
    "version": 1,
    "schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "initial": {}
  }
}
